# ─── Server ───────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
HOST_URL=http://localhost:3000

# ─── SurrealDB ────────────────────────────────────────────
SURREALDB_HOST=surrealdb
SURREALDB_PORT=8000
SURREALDB_USERNAME=root
SURREALDB_PASSWORD=root
SURREALDB_NAMESPACE=test
SURREALDB_NAME=test

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── SMTP (Email) ─────────────────────────────────────────
# Gmail: enable 2FA then generate an App Password at
# https://myaccount.google.com/apppasswords
SMTP_SERVER=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MY_EMAIL=noreply@local.dev

# Link included in verification emails (must match SERVER_PORT)
VERIFICATION_LINK=http://localhost:3000/verify-email

# ─── Auth / JWT ───────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret

# Verification token TTL in seconds (default: 900 = 15 min)
EXPIRE_TIME_EMAIL_VALIDATE_TOKEN=900